rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Required for listing all files under organizations/{orgId}/ from the app.
    // Keep read restricted to authenticated users.
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Required for recursive listing and fetching files across all org subfolders.
    // Existing path-specific write rules below remain in effect.
    match /organizations/{orgId}/{allPaths=**} {
      allow read: if isAuthenticated();
      // Allow delete operations for any org path shown in Files page.
      // Keep create/update denied here; specific path rules below handle uploads.
      allow write: if isAuthenticated() && request.resource == null;
    }

    // Allow public read access to branding assets (needed for displaying in brand sites)
    // Write access restricted to authenticated users only
    // The app-level code ensures users can only access their own organization's branding
    match /organizations/{orgId}/branding/{fileName} {
      allow read: if true; // Public read access for branding images (logos, gallery, etc.)
      allow write: if isAuthenticated()
                   && (request.resource == null || (
                        request.resource.size < 5 * 1024 * 1024
                        && request.resource.contentType.matches('image/.*')
                      ));
    }

    // Allow authenticated users to read invoice PDFs
    // PDFs are created by Cloud Functions, so no write access needed from client
    match /invoices/{orgId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Allow public read access to product images (needed for displaying in sites/proposals)
    // Write access restricted to authenticated users only
    match /organizations/{orgId}/products/{fileName} {
      allow read: if true; // Public read access for product images
      allow write: if isAuthenticated()
                   && (request.resource == null || (
                        request.resource.size < 5 * 1024 * 1024
                        && request.resource.contentType.matches('image/.*')
                      ));
    }

    // Allow public read access to article images (needed for displaying in blog posts)
    // Write access restricted to authenticated users only
    match /organizations/{orgId}/articles/{fileName} {
      allow read: if true; // Public read access for article images
      allow write: if isAuthenticated()
                   && (request.resource == null || (
                        request.resource.size < 10 * 1024 * 1024
                        && request.resource.contentType.matches('image/.*')
                      ));
    }

    // Brand site content - accessed by Cloud Functions (admin access)
    // No client-side access needed, Cloud Functions have admin privileges
    match /brand-sites/{brandSiteId}/{fileName} {
      allow read, write: if false; // Only Cloud Functions can access (admin)
    }

    match /brand-sites/{brandSiteId}/versions/{fileName} {
      allow read, write: if false; // Only Cloud Functions can access (admin)
    }

    match /organizations/{orgId}/files/{fileName} {
      allow read: if true; // Public read access for files
      allow write: if isAuthenticated()
                   && (request.resource == null || request.resource.size < 20 * 1024 * 1024); // 20MB max file size
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
