rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Allow authenticated users to read/write organization branding assets
    // The app-level code ensures users can only access their own organization's branding
    match /organizations/{orgId}/branding/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() 
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Allow authenticated users to read invoice PDFs
    // PDFs are created by Cloud Functions, so no write access needed from client
    match /invoices/{orgId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

