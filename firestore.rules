rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin bypass - admins have complete global access
    // Checks Firebase Auth custom claims first, then falls back to Firestore user document
    function isAdmin() {
      return request.auth != null && (
        // Check Firebase Auth custom claims (synced from Clerk via webhook)
        (request.auth.token.adminRole != null && 
         request.auth.token.adminRole in ['superadmin', 'billing_admin', 'support_admin', 'read_only_admin']) ||
        // Fallback: Check Firestore user document
        (getUser() != null && 
         getUser().data.adminRole != null && 
         getUser().data.adminRole in ['superadmin', 'billing_admin', 'support_admin', 'read_only_admin'])
      );
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }
    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isOrgMember(orgId) {
      let user = getUser();
      let org = get(/databases/$(database)/documents/organizations/$(orgId));
      let hasRole = user != null && 
                    user.data.organizationRoles != null && 
                    orgId in user.data.organizationRoles;
      return hasRole &&
             org != null &&
             user != null &&
             user.data.status == 'active' &&
             org.data.status == 'active';
    }
    function getUserRole(orgId) {
      let user = getUser();
      return user != null && user.data.organizationRoles != null ? 
             user.data.organizationRoles[orgId] : null;
    }
    function hasRole(orgId, requiredRole) {
      let role = getUserRole(orgId);
      return role != null && (
        (role == 'owner' && (requiredRole == 'owner' || requiredRole == 'admin' || requiredRole == 'member' || requiredRole == 'viewer')) ||
        (role == 'admin' && (requiredRole == 'admin' || requiredRole == 'member' || requiredRole == 'viewer')) ||
        (role == 'member' && (requiredRole == 'member' || requiredRole == 'viewer')) ||
        (role == 'viewer' && requiredRole == 'viewer')
      );
    }
    function isOwnerOrAdmin(orgId) {
      return hasRole(orgId, 'admin');
    }
    function belongsToOrg(orgId) {
      return resource.data.orgId == orgId || 
             resource.data.organizationId == orgId;
    }
    match /users/{userId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false; 
    }
    match /organizations/{orgId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                       request.resource.data.memberIds != null &&
                       request.resource.data.memberIds.size() > 0 &&
                       request.auth.uid == request.resource.data.memberIds[0] &&
                       getUser() != null &&
                       getUser().data.status == 'active';
      allow update: if isAuthenticated() && 
                       isOwnerOrAdmin(orgId) &&
                       request.resource.data.memberIds == resource.data.memberIds;
      allow delete: if false; 
    }
    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated() && 
                     isOrgMember(resource.data.orgId);
      allow create: if isAuthenticated() && 
                       request.resource.data.orgId != null &&
                       isOrgMember(request.resource.data.orgId) &&
                       hasRole(request.resource.data.orgId, 'member');
      allow update: if isAuthenticated() && 
                       belongsToOrg(resource.data.orgId) &&
                       request.resource.data.orgId == resource.data.orgId &&
                       isOwnerOrAdmin(resource.data.orgId);
      allow delete: if isAuthenticated() && 
                       belongsToOrg(resource.data.orgId) &&
                       isOwnerOrAdmin(resource.data.orgId);
    }
    match /templates/{templateId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated() && 
                     isOrgMember(resource.data.orgId);
      allow create: if isAuthenticated() && 
                       request.resource.data.orgId != null &&
                       isOrgMember(request.resource.data.orgId) &&
                       isOwnerOrAdmin(request.resource.data.orgId);
      allow update: if isAuthenticated() && 
                       belongsToOrg(resource.data.orgId) &&
                       request.resource.data.orgId == resource.data.orgId &&
                       isOwnerOrAdmin(resource.data.orgId);
      allow delete: if isAuthenticated() && 
                       belongsToOrg(resource.data.orgId) &&
                       isOwnerOrAdmin(resource.data.orgId);
    }
    match /workflows/{workflowId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated() && 
                     isOrgMember(resource.data.orgId);
      allow create: if isAuthenticated() && 
                       request.resource.data.orgId != null &&
                       isOrgMember(request.resource.data.orgId) &&
                       isOwnerOrAdmin(request.resource.data.orgId);
      allow update: if isAuthenticated() && 
                       belongsToOrg(resource.data.orgId) &&
                       request.resource.data.orgId == resource.data.orgId &&
                       isOwnerOrAdmin(resource.data.orgId);
      allow delete: if isAuthenticated() && 
                       belongsToOrg(resource.data.orgId) &&
                       isOwnerOrAdmin(resource.data.orgId);
    }
    match /products/{productId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated() && 
                     isOrgMember(resource.data.organizationId);
      allow create: if isAuthenticated() && 
                       request.resource.data.organizationId != null &&
                       isOrgMember(request.resource.data.organizationId) &&
                       isOwnerOrAdmin(request.resource.data.organizationId);
      allow update: if isAuthenticated() && 
                       belongsToOrg(resource.data.organizationId) &&
                       request.resource.data.organizationId == resource.data.organizationId &&
                       isOwnerOrAdmin(resource.data.organizationId);
      allow delete: if isAuthenticated() && 
                       belongsToOrg(resource.data.organizationId) &&
                       isOwnerOrAdmin(resource.data.organizationId);
    }
    match /proposals/{proposalId} {
      allow read, write: if isAdmin();
      allow list: if isAuthenticated();
      allow get: if isAuthenticated() && 
                    resource.data.organizationId != null &&
                    isOrgMember(resource.data.organizationId);
      allow create: if isAuthenticated() && 
                       request.resource.data.organizationId != null &&
                       isOrgMember(request.resource.data.organizationId) &&
                       hasRole(request.resource.data.organizationId, 'member');
      allow update: if isAuthenticated() && 
                       belongsToOrg(resource.data.organizationId) &&
                       request.resource.data.organizationId == resource.data.organizationId &&
                       isOwnerOrAdmin(resource.data.organizationId);
      allow delete: if isAuthenticated() && 
                       belongsToOrg(resource.data.organizationId) &&
                       isOwnerOrAdmin(resource.data.organizationId);
    }
    match /leads/{leadId} {
      allow read, write: if isAdmin();
      allow list: if isAuthenticated();
      allow get: if isAuthenticated() && 
                    resource.data.organizationId != null &&
                    isOrgMember(resource.data.organizationId);
      allow create: if isAuthenticated() && 
                       request.resource.data.organizationId != null &&
                       isOrgMember(request.resource.data.organizationId) &&
                       hasRole(request.resource.data.organizationId, 'member');
      allow update: if isAuthenticated() && 
                       belongsToOrg(resource.data.organizationId) &&
                       request.resource.data.organizationId == resource.data.organizationId &&
                       isOwnerOrAdmin(resource.data.organizationId);
      allow delete: if isAuthenticated() && 
                       belongsToOrg(resource.data.organizationId) &&
                       isOwnerOrAdmin(resource.data.organizationId);
    }
    match /contacts/{contactId} {
      allow read, write: if isAdmin();
      allow list: if isAuthenticated();
      allow get: if isAuthenticated() && 
                    resource.data.organizationId != null &&
                    isOrgMember(resource.data.organizationId);
      allow create: if isAuthenticated() && 
                       request.resource.data.organizationId != null &&
                       isOrgMember(request.resource.data.organizationId) &&
                       hasRole(request.resource.data.organizationId, 'member');
      allow update: if isAuthenticated() && 
                       belongsToOrg(resource.data.organizationId) &&
                       request.resource.data.organizationId == resource.data.organizationId &&
                       isOwnerOrAdmin(resource.data.organizationId);
      allow delete: if isAuthenticated() && 
                       belongsToOrg(resource.data.organizationId) &&
                       isOwnerOrAdmin(resource.data.organizationId);
    }
    match /brandSites/{siteId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated() && 
                     isOrgMember(resource.data.organizationId);
      allow create: if isAuthenticated() && 
                       request.resource.data.organizationId != null &&
                       isOrgMember(request.resource.data.organizationId) &&
                       isOwnerOrAdmin(request.resource.data.organizationId);
      allow update: if isAuthenticated() && 
                       belongsToOrg(resource.data.organizationId) &&
                       request.resource.data.organizationId == resource.data.organizationId &&
                       isOwnerOrAdmin(resource.data.organizationId);
      allow delete: if isAuthenticated() && 
                       belongsToOrg(resource.data.organizationId) &&
                       isOwnerOrAdmin(resource.data.organizationId);
    }
    match /invites/{inviteId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated() && 
                     isOrgMember(resource.data.organizationId);
      allow create: if isAuthenticated() && 
                       request.resource.data.organizationId != null &&
                       isOrgMember(request.resource.data.organizationId) &&
                       isOwnerOrAdmin(request.resource.data.organizationId);
      allow update: if isAuthenticated() && 
                       belongsToOrg(resource.data.organizationId) &&
                       request.resource.data.organizationId == resource.data.organizationId &&
                       isOwnerOrAdmin(resource.data.organizationId);
      allow delete: if isAuthenticated() && 
                       belongsToOrg(resource.data.organizationId) &&
                       isOwnerOrAdmin(resource.data.organizationId);
    }
    match /emailTemplateMappings/{mappingId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated() && 
                     isOrgMember(resource.data.orgId);
      allow create: if isAuthenticated() && 
                       request.resource.data.orgId != null &&
                       isOrgMember(request.resource.data.orgId) &&
                       isOwnerOrAdmin(request.resource.data.orgId);
      allow update: if isAuthenticated() && 
                       belongsToOrg(resource.data.orgId) &&
                       request.resource.data.orgId == resource.data.orgId &&
                       isOwnerOrAdmin(resource.data.orgId);
      allow delete: if isAuthenticated() && 
                       belongsToOrg(resource.data.orgId) &&
                       isOwnerOrAdmin(resource.data.orgId);
    }
    match /extractionJobs/{jobId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated() && 
                     isOrgMember(resource.data.orgId);
      allow create: if isAuthenticated() && 
                       request.resource.data.orgId != null &&
                       isOrgMember(request.resource.data.orgId) &&
                       hasRole(request.resource.data.orgId, 'member');
      allow update: if isAuthenticated() && 
                       belongsToOrg(resource.data.orgId) &&
                       request.resource.data.orgId == resource.data.orgId &&
                       hasRole(resource.data.orgId, 'member');
      allow delete: if isAuthenticated() && 
                       belongsToOrg(resource.data.orgId) &&
                       isOwnerOrAdmin(resource.data.orgId);
    }
    match /templatePatterns/{patternId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated() && 
                     isOrgMember(resource.data.orgId);
      allow create: if isAuthenticated() && 
                       request.resource.data.orgId != null &&
                       isOrgMember(request.resource.data.orgId) &&
                       isOwnerOrAdmin(request.resource.data.orgId);
      allow update: if isAuthenticated() && 
                       belongsToOrg(resource.data.orgId) &&
                       request.resource.data.orgId == resource.data.orgId &&
                       isOwnerOrAdmin(resource.data.orgId);
      allow delete: if isAuthenticated() && 
                       belongsToOrg(resource.data.orgId) &&
                       isOwnerOrAdmin(resource.data.orgId);
    }
    match /workflowRuns/{runId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated() && 
                     isOrgMember(resource.data.orgId);
      allow create: if false; 
      allow update: if false; 
      allow delete: if false; 
    }
    match /workflowVersions/{versionId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated() && 
                     resource.data.orgId != null &&
                     isOrgMember(resource.data.orgId);
      allow create: if false; 
      allow update: if false;
      allow delete: if false;
    }
    match /templateVersions/{versionId} {
      allow read, write: if isAdmin();
      // Allow queries for authenticated users (queries can't check resource.data for each doc)
      // Individual document reads will still be checked below
      allow list: if isAuthenticated();
      // Individual document read - check orgId
      allow get: if isAuthenticated() && 
                    resource.data.data != null &&
                    resource.data.data.orgId != null &&
                    isOrgMember(resource.data.data.orgId);
      allow create: if isAuthenticated() && 
                       request.resource.data.templateId != null &&
                       request.resource.data.data != null &&
                       request.resource.data.data.orgId != null &&
                       isOrgMember(request.resource.data.data.orgId) &&
                       isOwnerOrAdmin(request.resource.data.data.orgId);
      allow update: if false;
      allow delete: if isAuthenticated() && 
                       resource.data.data != null &&
                       resource.data.data.orgId != null &&
                       isOrgMember(resource.data.data.orgId) &&
                       isOwnerOrAdmin(resource.data.data.orgId);
    }
    match /organizations/{orgId}/auditLogs/{logId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated() && isOrgMember(orgId);
      allow create: if false; 
      allow update: if false;
      allow delete: if false;
    }
    match /organizations/{orgId}/analyticsEvents/{eventId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated() && isOrgMember(orgId);
      allow create: if false; 
      allow update: if false;
      allow delete: if false;
    }
    match /organizations/{orgId}/analyticsConfig/{configId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated() && isOrgMember(orgId);
      allow create: if isAuthenticated() && 
                       isOrgMember(orgId) &&
                       isOwnerOrAdmin(orgId);
      allow update: if isAuthenticated() && 
                       isOrgMember(orgId) &&
                       isOwnerOrAdmin(orgId);
      allow delete: if false;
    }
    // Usage tracking collections - write-only from backend (Cloud Functions)
    // These collections are used for billing/limits and must not be writable by clients
    match /usage_events/{eventId} {
      allow read: if false; // No client reads for now (backend-only analytics)
      allow create: if false; // Only backend can create usage events
      allow update: if false;
      allow delete: if false;
    }
    match /usage_aggregates_daily/{docId} {
      allow read: if false; // No client reads for now (backend-only analytics)
      allow create: if false; // Only backend can create/update aggregates
      allow update: if false;
      allow delete: if false;
    }
    match /usage_aggregates_monthly/{docId} {
      allow read: if false; // No client reads for now (backend-only analytics)
      allow create: if false; // Only backend can create/update aggregates
      allow update: if false;
      allow delete: if false;
    }
    // Marketplace templates - public read, contributor/admin write
    match /marketplaceTemplates/{templateId} {
      allow read, write: if isAdmin();
      
      // Allow reading published templates (for marketplace browsing)
      allow get: if isAuthenticated() && 
                   resource.data.status == 'published';
      
      // Allow reading templates where user is the author (for their submissions)
      allow get: if isAuthenticated() && 
                   resource.data.authorId == request.auth.uid;
      
      // Allow listing published templates (for marketplace queries)
      allow list: if isAuthenticated();
      
      // Only approved contributors or admins can create
      allow create: if isAuthenticated() && 
                       (getUser() != null && 
                        (getUser().data.isMarketplaceContributor == true || isAdmin()));
      
      // Template author or admins can update
      allow update: if isAuthenticated() && 
                       (resource.data.authorId == request.auth.uid || isAdmin());
      
      // Template author or admins can delete
      allow delete: if isAuthenticated() && 
                       (resource.data.authorId == request.auth.uid || isAdmin());
    }
    // Marketplace reviews - public read, authenticated users can create/update their own
    match /marketplaceReviews/{reviewId} {
      allow read, write: if isAdmin();
      // All authenticated users can read approved reviews
      allow read: if isAuthenticated();
      // All authenticated users can create reviews
      allow create: if isAuthenticated();
      // Review author can update their own review
      allow update: if isAuthenticated() && 
                       resource.data.userId == request.auth.uid;
      // Only admins can delete
      allow delete: if isAdmin();
    }
    // Admin global bypass - catch all for any other collections
    match /{document=**} {
      allow read, write: if isAdmin();
      allow read, write: if false;
    }
  }
}
