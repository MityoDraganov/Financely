{
  "rules": {
    "templates": {
      ".indexOn": ["orgId"],
      ".read": "auth != null",
      ".write": "auth != null",
      "$templateId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "organizations": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$orgId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "users": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$userId": {
        ".read": "auth != null && (auth.uid == $userId || auth.token.admin == true)",
        ".write": "auth != null && (auth.uid == $userId || auth.token.admin == true)"
      }
    }
  }
}

