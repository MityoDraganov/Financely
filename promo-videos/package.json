{
  "name": "financely-promo-videos",
  "version": "1.0.0",
  "description": "Remotion promo videos for Financely",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "render:v1": "remotion render src/index.ts FinancelyV1 --output out/video1.mp4",
    "render:v1:hq": "remotion render src/index.ts FinancelyV1 --output out/video1-hq.mp4 --codec h264 --crf 16"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "@remotion/google-fonts": "4.0.290",
    "@remotion/transitions": "4.0.290",
    "lucide-react": "^0.575.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.4.0"
  },
  "remotion": {
    "entrypoint": "src/index.ts"
  }
}
